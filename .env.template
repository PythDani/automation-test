# Configuración del proyecto de automatización
# Copia este archivo como .env y completa los valores

# URL de la aplicación (puedes cambiar entre nuxqa4 y nuxqa5)
HOME_URL=https://nuxqa4.avtest.ink/
CURRENT_ENVIRONMENT=nuxqa4

# Credenciales de usuario
USER_NAME=tu_usuario
USER_PASSWORD=tu_password

# Datos de tarjeta de crédito para pruebas
CARD_CREDIT_NUMBER=1234567812345678
CREDIT_PIN=1234

# Configuraciones de video (opcional)
ENABLE_VIDEO_RECORDING=true
MAX_VIDEO_SIZE_MB=50
VIDEO_QUALITY=medium
VIDEO_FPS=15

# Configuraciones de navegador (opcional)
BROWSER_HEADLESS=false
BROWSER_TIMEOUT=30
PAGE_LOAD_TIMEOUT=30

# Configuraciones de memoria (opcional)
ENABLE_MEMORY_MONITORING=true
MEMORY_CLEANUP_INTERVAL=5

# Configuraciones de testing (opcional)
PARALLEL_WORKERS=2
RETRY_COUNT=3
RETRY_DELAY=5
